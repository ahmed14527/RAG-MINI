# Copy to .env and fill in. Never commit .env.

# --- Django -----------------------------------------------------------------
# Settings module for backend/manage.py (dev) — Docker uses project.settings.prod.
DJANGO_SETTINGS_MODULE=project.settings.dev
# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# In Docker, if left empty, one is generated once and stored in the data volume.
SECRET_KEY=
# Production only (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to call the API from a browser (the frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
# Optional: also log to this file
LOG_FILE=

# --- LLM & embeddings (any OpenAI-compatible API) ----------------------------
# Required: key for the chat model (and embeddings unless overridden below)
OPENAI_API_KEY=
# Optional: custom endpoint, e.g. http://localhost:11434/v1 for Ollama
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
# Changing the embedding model requires (from backend/): python manage.py reindex_documents
EMBEDDING_MODEL=text-embedding-3-small
# Optional: use a different provider for embeddings
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- RAG tuning ---------------------------------------------------------------
RAG_CHUNK_SIZE=300
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
# Minimum cosine similarity (0-1) for a passage to be used as context
RAG_MIN_SCORE=0.2
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_UPLOAD_MB=20
RAG_CHAT_RATE=30/min
RAG_UPLOAD_RATE=60/hour

# --- Storage ------------------------------------------------------------------
# Where the SQLite DB, uploads (media/) and vector index (chroma_db/) live.
# Defaults to the backend/ directory; Docker uses /app/data (a volume).
# DATA_DIR=

# --- Docker Compose -----------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
# The API URL as seen from the user's browser
PUBLIC_API_URL=http://localhost:8000
